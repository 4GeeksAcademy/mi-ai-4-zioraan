{
  "name": "brasaland-website",
  "version": "0.1.0",
  "private": true,
  "description": "Brasaland public website and Brasa Points registration",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./styles.css -o ./assets/site.css --minify",
    "dev": "tailwindcss -i ./styles.css -o ./assets/site.css --watch",
    "preview": "http-server . -p 3000 -a 127.0.0.1 -c-1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "http-server": "14.1.1",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0"
  }
}
